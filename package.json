{
  "name": "frame-screenprint",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "description": "Local screen-print preparation: separate artwork into printable vector film positives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelhalunke/Frame-Siebdruck.git"
  },
  "bugs": {
    "url": "https://github.com/pixelhalunke/Frame-Siebdruck/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "prebuild": "npm run notices",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:acceptance": "vitest run src/test/acceptance.test.ts",
    "samples": "FRAME_WRITE_SAMPLES=1 vitest run src/test/acceptance.test.ts",
    "samples:textures": "FRAME_WRITE_TEXTURES=1 vitest run src/test/texture-import.test.ts",
    "notices": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "colord": "2.10.0",
    "idb": "8.0.4",
    "imagetracerjs": "1.2.6",
    "lucide-react": "1.66.0",
    "opentype.js": "2.0.0",
    "pathkit-wasm": "1.0.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svgpath": "2.6.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
